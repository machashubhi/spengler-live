{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spengler-live",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*"]
  },
  // Private bucket holding the Wisehockey-derived match files (npm run data:upload)
  "r2_buckets": [{ "binding": "MATCH_DATA", "bucket_name": "spengler-live-data" }],
  "vars": {
    // Other sites allowed to load match data when they embed the widget directly, comma-separated,
    // e.g. "https://www.spenglercup.ch". Pages on this subdomain (and iframes of it) need nothing here.
    "ALLOWED_ORIGINS": ""
  },
  // Your subdomain. Its zone must be on Cloudflare; the DNS record and certificate are created on deploy.
  "routes": [{ "pattern": "spengler.shubhamruhe.la", "custom_domain": true }]
}
